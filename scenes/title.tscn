[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/title.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://scenes/fx/film_filter.tscn" id="2_film"]
[ext_resource type="Texture2D" path="res://assets/art/world/background.png" id="3_bg"]
[ext_resource type="Texture2D" path="res://assets/art/world/floor.png" id="4_floor"]
